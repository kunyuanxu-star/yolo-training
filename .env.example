# YOLO Training Platform - Environment Variables
# Copy this file to .env and adjust as needed

# Application
APP_NAME=YOLO Training Platform
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-string

# Database — defaults to SQLite (zero dependencies, local file)
DATABASE_URL=sqlite:///./storage/app.db

# For PostgreSQL, uncomment and set:
# DATABASE_URL=postgresql://yolo:yolo@localhost:5432/yolo_training

# File Storage
STORAGE_ROOT=./storage
UPLOAD_MAX_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
